# Copy to .env and fill in. Never commit .env (it holds secrets).
PORT=5000
MONGO_URI=
JWT_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=

# --- AI image generation ------------------------------------------------------
# AI stays OFF unless AI_IMAGE_PROVIDER=gemini AND a real GEMINI_API_KEY is set
# ("none", "None", empty values and missing keys all mean OFF).
AI_IMAGE_PROVIDER=none
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_SIZE=2K

# Spending limits (application estimates, incl. GST). Each 0/unset = AI Generate
# blocked. Google Billing is the real balance; these are not a Google cap.
AI_BUDGET_INR=
AI_DAILY_LIMIT_INR=
AI_MAX_COST_PER_GENERATE_INR=
# Requests with UNKNOWN cost allowed before Generate is blocked (default 0).
AI_MAX_UNKNOWN_COST_REQUESTS=0
# Rate Google bills this account at, and GST.
AI_INR_PER_USD=96
AI_GST_RATE=0.18

# --- Shared file storage (AI artwork, previews, customer images) ---------------
# local = this computer's uploads folder (default). gridfs = MongoDB GridFS in
# the same Atlas database (every computer sees the same files; local files are
# still read as a fallback). Layouts, production files and print PDFs stay local.
STORAGE_DRIVER=local
# Atlas size limit (M0 free tier = 512) and free space needed before paid AI.
STORAGE_LIMIT_MB=512
STORAGE_MIN_FREE_MB=50
STORAGE_MB_PER_AI_DESIGN=15
# Signed image link lifetime in seconds (default 3600 = 1 hour).
STORAGE_URL_TTL_SECONDS=3600

# Upscaling of artwork (none = off).
UPSCALER_PROVIDER=none
